{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "main.py"
    }
  ],
  "functions": {
    "main.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "PYTHONUNBUFFERED": "1",
    "ARMORIQ_MODE": "mock",
    "ARGUS_DB": "libsql://argus-db-aditya013.aws-ap-south-1.turso.io"
  }
}
