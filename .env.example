# ─────────────────────────────────────────────────────────────────────
# AuthorChain — Environment Configuration
# ─────────────────────────────────────────────────────────────────────

# ArmorIQ Configuration
# Get your API key from https://platform.armoriq.ai
ARMORIQ_API_KEY=your_armoriq_api_key_here
ARMORIQ_MODE=real

# Shared HMAC secret used to sign/verify delegation tokens
ARMORIQ_SHARED_SECRET=authorchain-demo-secret-2026

# Token TTL for shopping agent (seconds) — keep short for live expiry demo
SHOPPING_AGENT_TTL=10
